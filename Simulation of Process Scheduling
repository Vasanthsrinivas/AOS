n = int(input("Enter number of processes: "))
bt = []
wt = [0] * n
tat = [0] * n
for i in range(n):
 bt.append(int(input(f"Enter burst time for P{i+1}: ")))
for i in range(1, n):
 wt[i] = wt[i-1] + bt[i-1]
avg_wt = 0
avg_tat = 0
for i in range(n):
 tat[i] = wt[i] + bt[i]
 avg_wt += wt[i]
 avg_tat += tat[i]
 print(f"P{i+1}\tBT={bt[i]}\tWT={wt[i]}\tTAT={tat[i]}")
print("Average Waiting Time =", avg_wt / n)
print("Average Turnaround Time =", avg_tat / n)
